# Mad Library Team Server local development configuration.
# Copy to .env in the repository root when running the server manually.

MADLIBRARY_SERVER_HOST=127.0.0.1
MADLIBRARY_SERVER_PORT=3789

# auto | bundled | external
# auto uses DATABASE_URL when provided; otherwise it starts packaged PostgreSQL.
MADLIBRARY_POSTGRES_MODE=external

# Example:
# postgresql://postgres:postgres@localhost:5432/madlibrary_team
MADLIBRARY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/madlibrary_team

# Server-managed storage folder for copy-mode team imports.
# Relative paths are resolved from the repository root.
MADLIBRARY_STORAGE_DIR=.dev/storage

# Development only. Keep false for LAN and hosted deployments.
MADLIBRARY_ALLOW_PERSONAL_STORAGE_PATHS=false

# local | private_cloud | hosted_cloud
MADLIBRARY_DEPLOYMENT_MODE=local

# Optional. Defaults to target/build/frontend/admin-ui.
# MADLIBRARY_ADMIN_ASSETS_DIR=E:\AI\codex\madlibrary_server\target\build\frontend\admin-ui

# Replace before any real LAN/private deployment.
MADLIBRARY_JWT_SECRET=dev-only-change-me

MADLIBRARY_TOKEN_TTL_HOURS=168
