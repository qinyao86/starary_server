# Starary Server local development configuration.
# Copy to .env in the repository root when running the server manually.

STARARY_SERVER_HOST=127.0.0.1
STARARY_SERVER_PORT=3789

# auto | bundled | external
# auto uses DATABASE_URL when provided; otherwise it starts packaged PostgreSQL.
STARARY_POSTGRES_MODE=external

# Example:
# postgresql://postgres:postgres@localhost:5432/starary_team
STARARY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starary_team

# Server-managed storage folder for copy-mode team imports.
# Relative paths are resolved from the repository root.
STARARY_STORAGE_DIR=.dev/storage

# Development only. Keep false for LAN and hosted deployments.
STARARY_ALLOW_PERSONAL_STORAGE_PATHS=false

# local | private_cloud | hosted_cloud
STARARY_DEPLOYMENT_MODE=local

# Optional. Defaults to target/build/frontend/admin-ui.
# STARARY_ADMIN_ASSETS_DIR=E:\AI\codex\madlibrary_server\target\build\frontend\admin-ui

# Replace before any real LAN/private deployment.
STARARY_JWT_SECRET=dev-only-change-me

STARARY_TOKEN_TTL_HOURS=168
