{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mad Library Server",
  "version": "0.1.0",
  "identifier": "cn.madlibrary.server.desktop",
  "build": {
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File ../scripts/prepare-desktop-bundle.ps1",
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mad Library Server",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 680,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#f5f6f8"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "bundle-resources/runtime": "runtime"
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
